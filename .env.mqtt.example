# AWS IoT MQTT configuration template. Copy to .env.mqtt.local and adjust for deployment.
MQTT_CERTIFICATE_ARN=arn:aws:iot:<region>:<account-id>:cert/<certificate-id>
MQTT_ENDPOINT=<aws-iot-endpoint>.iot.<region>.amazonaws.com
MQTT_PORT=8883
MQTT_TOPIC=kloudtrack/+/data
MQTT_CLIENT_ID=kloudtrack-dashboard-ingestor
MQTT_STATUS_MAX_AGE_SECONDS=300
MQTT_STATION_CACHE_MAX_AGE_SECONDS=900
MQTT_PREDICTION_SEQUENCE_LENGTH=24
MQTT_PREDICTION_INTERVAL_SECONDS=300

# Use mounted secret files in production. Never put PEM contents in this file or Git.
MQTT_CA_PATH=/run/secrets/AmazonRootCA1.pem
MQTT_CERT_PATH=/run/secrets/device-certificate.pem.crt
MQTT_PRIVATE_KEY_PATH=/run/secrets/device-private.pem.key

# This path must be on persistent storage shared with the dashboard only for a
# self-hosted deployment. Vercel functions cannot consume this local file.
MQTT_LIVE_CACHE_PATH=/var/lib/kloudtrack/mqtt_live_predictions.json
MQTT_OBSERVATION_HISTORY_PATH=/var/lib/kloudtrack/mqtt_observation_history.json
