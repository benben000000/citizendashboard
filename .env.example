# Kloudtrack telemetry API Configuration (Server-side only - DO NOT add NEXT_PUBLIC_ prefix)
# NOTE: the variable the server actually reads is KLOUDTRACK_API_TOKEN.
# KLOUDTRACK_API_KEY below is retained only for reference and is NOT read anywhere.
KLOUDTRACK_API_BASE_URL=
KLOUDTRACK_API_TOKEN=

# Mapbox API Key (client-side public token; requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_MAPBOX_API_KEY=

# Polling Configuration
# NOTE: these are not read at runtime. Dashboard polling cadence and API cache
# TTLs are set in src/lib/config/cache.config.ts. Kept for documentation.
NEXT_PUBLIC_POLLING_INTERVAL=

# Caching Configuration (Server-side)
ENABLE_API_CACHE=
CACHE_TTL_SECONDS=

# Site URL used for absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Portal authentication (Server-side, REQUIRED)
# ---------------------------------------------------------------------------
# The portal FAILS CLOSED without these. There are no built-in defaults: a
# deployment that omits them cannot log in, and the benchmark export endpoint
# returns 503. This replaces the previously hardcoded credentials
# ("admin" / "Kloudtrack2026!") that were committed to the repository.
#
# Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_ADMIN_USER=
PORTAL_ADMIN_PASSWORD=
PORTAL_SECRET_SALT=

# ---------------------------------------------------------------------------
# Forecast freshness (Server-side, optional)
# ---------------------------------------------------------------------------
# Maximum age, in seconds, of the Python engine output in
# prediction-model/data/mqtt_live_predictions.json before the dashboard will
# present it as a current forecast. Beyond this the UI shows the reason and
# falls back to observation-only. Falls back to MQTT_STATUS_MAX_AGE_SECONDS, then
# 600.
FORECAST_MAX_AGE_SECONDS=600

# Age, in seconds, after which the live MQTT cache is reported as STALE by
# /api/prediction/mqtt/live.
MQTT_STATUS_MAX_AGE_SECONDS=300

# ── NWP-corrected hybrid router ────────────────────────────────────────
# OFF by default. When enabled, forecasts for the routed (horizon, variable)
# cells are replaced by a bias-corrected NOAA GFS forecast instead of the LNN
# output. The gate is closed unless ALL of the following hold:
#   * this flag is set
#   * the source is APPROVED in prediction-model/data/external_source_registry.json
#   * a matching correction artifact exists
#   * the supplied NWP values are fresher than NWP_MAX_AGE_HOURS
# Any failure degrades to the current LNN output unchanged, so the worst case
# of turning this on is that it does nothing.
#
# Measured effect on the held-out test split, GFS artifact:
#   mean error reduction vs the LNN  +3.2%   (5 of 20 cells improved,
#   15 unchanged, 0 regressed)
# The ECMWF artifact is stronger (+10.3%) but is NOT licence-cleared and is
# therefore not wired to any registered source.
NWP_HYBRID_ENABLED=false
NWP_HYBRID_SOURCE=noaa_gfs_v1
# Reject an NWP value older than this. A value with no usable timestamp is
# treated as stale and ignored, because freshness cannot be proven.
NWP_MAX_AGE_HOURS=6
