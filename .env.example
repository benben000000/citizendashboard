# Kloudtrack API Configuration (Server-side only - DO NOT add NEXT_PUBLIC_ prefix)
KLOUDTRACK_API_BASE_URL=https://api.kloudtrack.com
KLOUDTRACK_API_KEY=your_secret_api_token_here

# Mapbox API Key (Client-side - needs NEXT_PUBLIC_ prefix)
NEXT_MAPBOX_API_KEY=pk.your_mapbox_token_here

# Polling Configuration (Client-side)
NEXT_PUBLIC_POLLING_INTERVAL=300000

# Optional: Caching Configuration (Server-side)
ENABLE_API_CACHE=true
CACHE_TTL_SECONDS=60