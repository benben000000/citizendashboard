    },
    {
      "name": "mk-line-graph",
      "type": "hyperframes:block",
      "target": "compositions/mk-line-graph.html"
    },
    {
      "name": "dynamic-grid",
      "type": "hyperframes:component",
      "target": "compositions/components/dynamic-grid.html"
    },
    {
      "name": "mk-progress-stat",
      "type": "hyperframes:block",
      "target": "compositions/mk-progress-stat.html"
    }
  ]
}
